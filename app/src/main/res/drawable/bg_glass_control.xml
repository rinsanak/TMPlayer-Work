<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="oval"><solid android:color="#FF66DFEE"/><stroke android:width="2dp" android:color="#FFFFFFFF"/></shape></item>
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="#9966DFEE"/></shape></item>
    <item><shape android:shape="oval"><gradient android:angle="270" android:startColor="#38FFFFFF" android:endColor="#0CFFFFFF"/><stroke android:width="1dp" android:color="#38FFFFFF"/></shape></item>
</selector>
