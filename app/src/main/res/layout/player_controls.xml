<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/player_controls" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" android:visibility="gone">
  <View android:id="@+id/controls_scrim_top" android:layout_width="match_parent" android:layout_height="@dimen/player_scrim_top" android:layout_gravity="top" android:background="@drawable/bg_controls_scrim_top" />
  <View android:id="@+id/controls_scrim_bottom" android:layout_width="match_parent" android:layout_height="180dp" android:layout_gravity="bottom" android:background="@drawable/bg_controls_scrim_bottom" />
  <TextView android:id="@+id/controls_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_marginStart="24dp" android:layout_marginTop="16dp" android:textColor="#E6FFFFFF" android:textSize="15sp" android:visibility="gone" />
  <View android:id="@+id/controls_tint" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#40000000" android:visibility="gone" />
  <LinearLayout android:id="@+id/controls_topbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:gravity="end" android:minHeight="56dp" android:orientation="vertical" android:paddingLeft="4dp" android:paddingRight="4dp" android:visibility="gone" android:background="@android:color/transparent" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageButton android:id="@+id/control_back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_control_button" android:contentDescription="Back" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_arrow_back" android:tint="@color/player_control_icon" />
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/topbar_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/topbar_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#B8FFFFFF" android:textSize="14sp" android:visibility="gone" />
      </LinearLayout>
      <ImageButton android:id="@+id/control_cast" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_control_button" android:contentDescription="Cast to a TV" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_cast" android:tint="@color/player_control_icon" android:visibility="gone" />
      <HorizontalScrollView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:id="@+id/controls_buttons" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@android:color/transparent" android:orientation="horizontal" android:paddingStart="0dp" android:paddingTop="4dp" android:paddingEnd="4dp" android:paddingBottom="4dp">
          <ImageButton android:id="@+id/control_subtitles" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:background="@drawable/bg_control_button" android:contentDescription="Subtitles" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_subtitles" android:tint="@color/player_control_icon" android:nextFocusDown="@id/controls_timebar" />
          <ImageButton android:id="@+id/control_audio" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:background="@drawable/bg_control_button" android:contentDescription="Audio" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_audio_language" android:tint="@color/player_control_icon" android:nextFocusDown="@id/controls_timebar" />
          <ImageButton android:id="@+id/control_speed" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:background="@drawable/bg_control_button" android:contentDescription="Playback speed" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_speed" android:tint="@color/player_control_icon" android:nextFocusDown="@id/controls_timebar" />
          <ImageButton android:id="@+id/control_shape" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:background="@drawable/bg_control_button" android:contentDescription="Picture shape" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_shape_fit" android:tint="@color/player_control_icon" android:visibility="gone" android:nextFocusDown="@id/controls_timebar" />
          <ImageButton android:id="@+id/control_rotate" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:background="@drawable/bg_control_button" android:contentDescription="Screen orientation" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_rotate_landscape" android:tint="@color/player_control_icon" android:visibility="gone" android:nextFocusDown="@id/controls_timebar" />
          <ImageButton android:id="@+id/control_lock" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:background="@drawable/bg_control_button" android:contentDescription="Lock the screen" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_lock" android:tint="@color/player_control_icon" android:visibility="gone" android:nextFocusDown="@id/controls_timebar" />
          <ImageButton android:id="@+id/control_tv_more" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:background="@drawable/bg_control_button" android:contentDescription="More" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_more_vert" android:tint="@color/player_control_icon" android:visibility="gone" android:nextFocusDown="@id/controls_timebar" />
          <TextView android:id="@+id/control_copy" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/bg_control_pill" android:clickable="true" android:drawableStart="@drawable/ic_copies" android:drawablePadding="8dp" android:drawableTint="@color/player_control_icon" android:focusable="true" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="12dp" android:paddingEnd="16dp" android:textColor="@color/player_control_icon" android:textSize="13sp" android:visibility="gone" android:nextFocusDown="@id/controls_timebar" />
        </LinearLayout>
      </HorizontalScrollView>
      <ImageButton android:id="@+id/control_more" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_control_button" android:contentDescription="More options" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_more_vert" android:tint="@color/player_control_icon" />
    </LinearLayout>
    <LinearLayout android:id="@+id/controls_center" android:layoutDirection="ltr" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:orientation="horizontal" android:visibility="gone" android:layout_marginTop="0dp" android:layout_gravity="right">
      <ImageButton android:id="@+id/center_previous" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_control_button" android:contentDescription="Previous episode" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_player_previous" android:tint="@color/player_control_icon" android:visibility="invisible" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" />
      <FrameLayout android:id="@+id/center_play_pause" android:accessibilityLiveRegion="polite" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/bg_control_button" android:clickable="true" android:contentDescription="Pause" android:focusable="true">
        <com.tmplayer.player.PlayPauseIcon android:id="@+id/center_play_icon" android:duplicateParentState="true" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:importantForAccessibility="no" />
        <ProgressBar android:id="@+id/center_buffering" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:indeterminateTint="#FFFFFFFF" android:visibility="gone" />
      </FrameLayout>
      <ImageButton android:id="@+id/center_next" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_control_button" android:contentDescription="Next episode" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_player_next" android:tint="@color/player_control_icon" android:visibility="invisible" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" />
      <TextView android:id="@+id/center_previous_caption" android:layout_width="wrap_content" android:layout_height="@dimen/player_episode_caption" android:layout_marginTop="@dimen/player_episode_caption_gap" android:background="@drawable/bg_player_caption" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:gravity="center" android:importantForAccessibility="no" android:maxLines="1" android:maxWidth="64dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textColor="#F2FFFFFF" android:textSize="12sp" android:visibility="gone" />
      <TextView android:id="@+id/center_next_caption" android:layout_width="wrap_content" android:layout_height="@dimen/player_episode_caption" android:layout_marginTop="@dimen/player_episode_caption_gap" android:background="@drawable/bg_player_caption" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:gravity="center" android:importantForAccessibility="no" android:maxLines="1" android:maxWidth="64dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textColor="#F2FFFFFF" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/controls_cluster" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingBottom="6dp" android:background="@android:color/transparent" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="10dp" android:paddingTop="6dp">
    <TextView android:id="@+id/controls_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="16sp" />
    <TextView android:id="@+id/controls_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="#B8FFFFFF" android:textSize="14sp" android:visibility="gone" />
    <com.tmplayer.player.FineTimeBar android:id="@+id/controls_timebar" android:layoutDirection="ltr" android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="@dimen/player_timebar_gap" android:background="@drawable/bg_timebar_focus" android:focusable="true" android:nextFocusDown="@id/center_play_pause" app:ad_marker_color="#FFFFC107" app:bar_height="4dp" app:buffered_color="#592AABEE" app:played_color="@color/accent" app:scrubber_color="@color/accent" app:scrubber_dragged_size="18dp" app:scrubber_enabled_size="12dp" app:touch_target_height="28dp" app:unplayed_color="#4DFFFFFF" />
    <LinearLayout android:id="@+id/controls_times" android:layoutDirection="ltr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:orientation="horizontal" android:visibility="gone" android:gravity="center_vertical">
      <TextView android:id="@+id/times_position" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#B8FFFFFF" android:textSize="13sp" />
      <TextView android:id="@+id/times_duration" android:layout_width="0dp" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:contentDescription="Show the time remaining" android:minWidth="48dp" android:gravity="end" android:paddingStart="8dp" android:textColor="#B8FFFFFF" android:textSize="13sp" android:layout_weight="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layoutDirection="ltr" android:layout_height="0dp" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
      <TextView android:id="@+id/controls_time" android:textDirection="ltr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:nextFocusUp="@id/controls_timebar" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:textColor="#B8FFFFFF" android:textSize="14sp" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>